# Safe local-development defaults. Copy outside the repository before editing.
DRY_RUN=true
# Optional service port: set CLICKUP_ROUTER_PORT in the caller when needed.

# Neutral routing target for synthetic tests.
KANBAN_BOARD=example
CLICKUP_LIST_IDS=
CLICKUP_USER_PROFILE_MAP=
CLICKUP_EMAIL_PROFILE_MAP=
CLICKUP_USERNAME_PROFILE_MAP=
CLICKUP_AGENT_USER_IDS=

# Human-layer behaviour (all optional; shown with defaults).
# CLICKUP_WRITEBACK=true
# STATUS_ON_TRIGGER=in progress
# COMPLETE_STATUS=complete
# REVIEW_STATUS=
# ROUTE_ASSIGNEE_CHANGES=true
# RECONCILE_INTERVAL_SECONDS=300
# BLOCKED_RENOTIFY_HOURS=24
# SWEEP_LOOKBACK_HOURS=24
# Public URL ClickUp delivers to; enables webhook health checks.
CLICKUP_WEBHOOK_ENDPOINT=
# SQLite state so dedupe keys and links survive restarts.
CLICKUP_ROUTER_STATE_DB=

# Leave every credential empty for preview and contribution work.
CLICKUP_TEAM_ID=
CLICKUP_API_TOKEN=
CLICKUP_WEBHOOK_SECRET=
ROUTER_SHARED_TOKEN=
